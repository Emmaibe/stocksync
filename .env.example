# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# These are the names this service actually reads. Several names carried over
# from the ASCCAAU/stockapi projects (MAIL_PROVIDER, SMTP_HOST, SENDGRID_API_KEY,
# FRONTEND_*) are NOT read here and would be silently ignored.

# --- Database -------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/stocksync
DB_USERNAME=stocksync
DB_PASSWORD=
DB_POOL_MAX=10

# --- JWT ------------------------------------------------------------------
# No default: the application refuses to start without it. At least 32 bytes.
#   openssl rand -base64 48
# Rotating this signs everyone out at once.
JWT_SECRET=
JWT_ISSUER=stocksync
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Web ------------------------------------------------------------------
SERVER_PORT=8080
# Comma-separated. A browser origin not listed here cannot call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Email ----------------------------------------------------------------
# Leave SPRING_MAIL_HOST unset to log emails instead of sending them — the
# startup log says which mode is active. Setting it switches on real delivery.
# SPRING_MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@stocksync.local
MAIL_FROM_NAME=StockSync
MAIL_BATCH_SIZE=25
MAIL_DISPATCH_INTERVAL_MS=30000

# Where the links in emails point: the web app, not this API. One value, used
# for both invitation and password-reset links (/accept-invitation, /reset-password).
APP_BASE_URL=http://localhost:3000
